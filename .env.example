# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# Auth
# The public-facing URL of your app (used by better-auth for callbacks and magic links)
APP_URL="http://localhost:3000"

# You can generate a new secret on the command line with:
# openssl rand -base64 32
AUTH_SECRET=""

# Optional Discord OAuth: leave both empty to disable it.
# Redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# SMTP (for magic link email authentication)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_MAIL_FROM="noreply@example.com"

# Drizzle
DATABASE_URL="postgresql://user:password@localhost:5432/walls"
# Optional: require SSL for Drizzle CLI connections (including migrations)
DATABASE_SSL="false"
